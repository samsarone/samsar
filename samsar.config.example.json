{
  "runtime": "docker",
  "deploymentEdition": "standalone",
  "security": {
    "tokenSecret": "",
    "customAdapterSecret": "",
    "loginTokenTtlSeconds": 3600
  },
  "database": {
    "provider": "local-mongo",
    "mongoUrl": ""
  },
  "storage": {
    "mode": "local-minio",
    "provider": "s3-compatible",
    "backend": "minio",
    "mediaBucketName": "samsar-resources",
    "staticCdnUrl": "http://localhost:3002/",
    "secureAssetPrefix": "assets_v2",
    "accessKeyId": "",
    "secretAccessKey": "",
    "region": "us-east-1",
    "s3Endpoint": "http://minio:9000",
    "s3ForcePathStyle": true,
    "objectTaggingSupported": true,
    "credentialType": "",
    "externalMediaPublishEnabled": false,
    "cloudFront": {
      "keyPairId": "",
      "privateKey": "",
      "privateKeyBase64": "",
      "signedUrlTtlSeconds": 604800
    }
  },
  "publicUrls": {
    "clientApp": "http://localhost:3000",
    "processorApi": "http://localhost:3002",
    "samsarApi": "https://api.samsar.one/v1",
    "media": "http://localhost:3002"
  },
  "localMediaTunnel": {
    "enabled": false,
    "provider": "cloudflared",
    "publicUrl": "",
    "refreshWaitMs": 120000,
    "refreshPollMs": 500
  },
  "reverseProxy": {
    "enabled": false,
    "accessType": "publicDomain",
    "clientHost": "",
    "processorHost": "",
    "machineIp": "",
    "openFirewallPorts": false,
    "ssl": {
      "enabled": false,
      "email": "",
      "certName": "samsar-reverse-proxy"
    }
  },
  "providers": {
    "samsar": {
      "enabled": false,
      "apiKey": ""
    },
    "openai": {
      "enabled": false,
      "apiKey": ""
    },
    "googleCloud": {
      "enabled": false,
      "projectId": "",
      "credentialsJsonB64": ""
    },
    "openrouter": {
      "enabled": false,
      "gemini31ProModel": "google/gemini-3.1-pro-preview"
    },
    "gmicloud": {
      "enabled": false,
      "credentialFingerprint": "",
      "chatBaseUrl": "",
      "mediaBaseUrl": "",
      "modelMappings": {}
    },
    "kimi": {
      "enabled": false,
      "apiKey": ""
    },
    "alibabaCloud": {
      "enabled": false,
      "keyType": "",
      "endpointType": ""
    },
    "fal": {
      "enabled": false,
      "apiKey": ""
    },
    "elevenlabs": {
      "enabled": false,
      "apiKey": ""
    },
    "runway": {
      "enabled": false,
      "apiKey": ""
    }
  },
  "services": {
    "workers": true,
    "setupWizard": true,
    "localMongo": true,
    "minio": true,
    "mediaGateway": true,
    "genblaze": false,
    "logger": true
  }
}
