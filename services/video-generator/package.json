{
  "name": "samsar_video_generator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "preinstall": "node ./scripts/ensure-node-abi.mjs",
    "postinstall": "npm run rebuild:native",
    "prestart": "npm run check:native",
    "start": "node index.js",
    "build": "node --check index.js && rg --files -0 -g \"*.js\" src | xargs -0 -n 50 node --check",
    "check:native": "node ./scripts/check-native-modules.mjs",
    "rebuild:native": "npm rebuild sharp && npm run check:native",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.743.0",
    "@aws-sdk/client-ses": "^3.743.0",
    "@aws-sdk/lib-storage": "^3.743.0",
    "@vercel/stega": "^0.1.2",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.0",
    "mongoose": "^8.4.1",
    "nodemailer": "^9.0.3",
    "sharp": "^0.33.4"
  }
}
