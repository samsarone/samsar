{
  "id": null,
  "uid": "docker-logs-overview",
  "title": "Samsar Docker Logs",
  "tags": ["samsar", "docker", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Service",
        "type": "query",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({job=\"docker\"}, app)",
        "query": "label_values({job=\"docker\"}, app)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Lines (5m)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"docker\", app=~\"$app\"}[5m]))",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors (5m)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"docker\", app=~\"$app\"} |~ \"(?i)(error|fatal|exception|failed)\" [5m]))",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "title": "Services Logging",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(count_over_time({job=\"docker\", app=~\"$app\"}[5m]))",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "title": "Loki Streams",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "count(count_over_time({compose_project=\"samsar\"}[5m]))",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "title": "Log Rate by Service",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (app) (count_over_time({job=\"docker\", app=~\"$app\"}[1m]))",
          "legendFormat": "{{app}}",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "title": "Error Rate by Service",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (app) (count_over_time({job=\"docker\", app=~\"$app\"} |~ \"(?i)(error|fatal|exception|failed)\" [1m]))",
          "legendFormat": "{{app}}",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recent Errors",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"docker\", app=~\"$app\"} |~ \"(?i)(error|fatal|exception|failed)\"",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 8,
      "title": "All Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"docker\", app=~\"$app\"}",
          "refId": "A",
          "queryType": "range"
        }
      ]
    }
  ]
}
